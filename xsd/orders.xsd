<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:element name="Orders">
        <xs:annotation>
            <xs:documentation>
                Root Element für Bestellungen.
                Das count Attribut gibt die Anzahl der enthaltenen Bestellungen an.

                Beispiel:
                &lt;Orders count="1"&gt;
                  &lt;Order num="1"&gt;...&lt;/Order&gt;
                &lt;/Orders&gt;
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="Order" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="count" type="xs:integer">
                <xs:annotation>
                    <xs:documentation>
                        Anzahl der enthaltenen Datensätze. Reine Information: Der Wert wird nicht gegen die
                        tatsächliche Anzahl geprüft, es kann also auch ein Näherungswert übergeben werden.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="Order">
        <xs:annotation>
            <xs:documentation>
                Einzelne Bestellung.

                Beispiel:
                &lt;Order num="1"&gt;
                  &lt;OrderId&gt;1&lt;/OrderId&gt;
                  &lt;OrderDate&gt;2023-04-01&lt;/OrderDate&gt;
                  &lt;OrderStatus&gt;completed&lt;/OrderStatus&gt;
                  &lt;PaymentStatus&gt;paid&lt;/PaymentStatus&gt;
                  &lt;CustomerId&gt;1&lt;/CustomerId&gt;
                  &lt;IsoCurrencyCode&gt;EUR&lt;/IsoCurrencyCode&gt;
                  &lt;TotalAmountProducts&gt;45.90&lt;/TotalAmountProducts&gt;
                  &lt;TotalAmountProductsNetto&gt;38.57&lt;/TotalAmountProductsNetto&gt;
                  &lt;TotalAmountVat&gt;7.33&lt;/TotalAmountVat&gt;
                  &lt;ShippingCost&gt;5.00&lt;/ShippingCost&gt;
                  &lt;PaymentCost&gt;0.00&lt;/PaymentCost&gt;
                  &lt;TotalAmount&gt;45.90&lt;/TotalAmount&gt;
                  &lt;Comment&gt;Bestellung erfolgreich abgeschlossen&lt;/Comment&gt;
                  &lt;InternalRemark&gt;&lt;/InternalRemark&gt;
                  &lt;CostsChangings&gt;
                    &lt;CostsChanging&gt;
                      &lt;TypeValue&gt;5.50000000&lt;/TypeValue&gt;
                      &lt;Value&gt;10.78000000&lt;/Value&gt;
                      &lt;Name&gt;&lt;/Name&gt;
                    &lt;/CostsChanging&gt;
                  &lt;/CostsChangings&gt;
                  &lt;PaymentMethod&gt;creditcard&lt;/PaymentMethod&gt;
                  &lt;PaymentMethodValues&gt;
                    &lt;cardAuthorization&gt;96897GJHGJH6896789IUI97897ZUIZUI&lt;/cardAuthorization&gt;
                    &lt;shortId&gt;3152.2746.4745&lt;/shortId&gt;
                    &lt;transactionId&gt;76ghs676sdfhus878sfh897szuzu&lt;/transactionId&gt;
                  &lt;/PaymentMethodValues&gt;
                  &lt;ShippingMethod&gt;standard&lt;/ShippingMethod&gt;
                  &lt;LanguageCode&gt;de&lt;/LanguageCode&gt;
                  &lt;OrderAddInfos count="1"&gt;
                    &lt;OrderAddInfo num="1"&gt;
                      &lt;Key&gt;Marktplatz- oder Shopkey&lt;/Key&gt;
                      &lt;Value&gt;XYZ&lt;/Value&gt;
                    &lt;/OrderAddInfo&gt;
                  &lt;/OrderAddInfos&gt;
                  &lt;BillingParty&gt;
                    &lt;AcademicTitle&gt;Dr.&lt;/AcademicTitle&gt;
                    &lt;Company&gt;Musterfirma&lt;/Company&gt;
                    &lt;CompanyAdd&gt;Musterstraße 1&lt;/CompanyAdd&gt;
                    &lt;VatId&gt;DE123456789&lt;/VatId&gt;
                    &lt;FirstName&gt;Max&lt;/FirstName&gt;
                    &lt;LastName&gt;Muster&lt;/LastName&gt;
                    &lt;Address&gt;Musterstraße 1&lt;/Address&gt;
                    &lt;Number&gt;1&lt;/Number&gt;
                    &lt;AddressAdd&gt;&lt;/AddressAdd&gt;
                    &lt;PostalCode&gt;12345&lt;/PostalCode&gt;
                    &lt;City&gt;Musterstadt&lt;/City&gt;
                    &lt;Country&gt;Deutschland&lt;/Country&gt;
                    &lt;State&gt;Bayern&lt;/State&gt;
                    &lt;PhonePrivate&gt;+49 1234 567890&lt;/PhonePrivate&gt;
                    &lt;PhoneMobile&gt;+49 1234 567890&lt;/PhoneMobile&gt;
                    &lt;Title&gt;Dr.&lt;/Title&gt;
                    &lt;EmailAddress&gt;max.muster@example.com&lt;/EmailAddress&gt;
                    &lt;DateOfBirth&gt;1970-01-01&lt;/DateOfBirth&gt;
                  &lt;/BillingParty&gt;
                  &lt;DeliveryParty&gt;
                    &lt;AcademicTitle&gt;Dr.&lt;/AcademicTitle&gt;
                    &lt;Company&gt;Musterfirma&lt;/Company&gt;
                    &lt;CompanyAdd&gt;Musterstraße 1&lt;/CompanyAdd&gt;
                    &lt;VatId&gt;DE123456789&lt;/VatId&gt;
                    &lt;FirstName&gt;Max&lt;/FirstName&gt;
                    &lt;LastName&gt;Muster&lt;/LastName&gt;
                    &lt;Address&gt;Musterstraße 1&lt;/Address&gt;
                    &lt;Number&gt;1&lt;/Number&gt;
                    &lt;AddressAdd&gt;&lt;/AddressAdd&gt;
                    &lt;PostalCode&gt;12345&lt;/PostalCode&gt;
                    &lt;City&gt;Musterstadt&lt;/City&gt;
                    &lt;Country&gt;Deutschland&lt;/Country&gt;
                    &lt;State&gt;Bayern&lt;/State&gt;
                    &lt;PhonePrivate&gt;+49 1234 567890&lt;/PhonePrivate&gt;
                    &lt;PhoneMobile&gt;+49 1234 567890&lt;/PhoneMobile&gt;
                    &lt;Title&gt;Dr.&lt;/Title&gt;
                    &lt;EmailAddress&gt;max.muster@example.com&lt;/EmailAddress&gt;
                    &lt;DateOfBirth&gt;1970-01-01&lt;/DateOfBirth&gt;
                  &lt;/DeliveryParty&gt;
                  &lt;Coupons count="1"&gt;
                    &lt;Coupon&gt;
                      &lt;Id&gt;1&lt;/Id&gt;
                      &lt;ExternId&gt;BF_COUPON&lt;/ExternId&gt;
                      &lt;Code&gt;BF_COUPON&lt;/Code&gt;
                      &lt;Type&gt;discount&lt;/Type&gt;
                      &lt;ReduceType&gt;percentage&lt;/ReduceType&gt;
                      &lt;Rebate&gt;25.00&lt;/Rebate&gt;
                      &lt;Title&gt;25% Rabatt&lt;/Title&gt;
                      &lt;CalculatedRebate&gt;25.00&lt;/CalculatedRebate&gt;
                      &lt;Group&gt;
                        &lt;Id&gt;1&lt;/Id&gt;
                        &lt;ExternId&gt;BF_COUPON&lt;/ExternId&gt;
                        &lt;Title&gt;Rabatt Gutschein&lt;/Title&gt;
                      &lt;/Group&gt;
                      &lt;OrderLineReferences&gt;
                        &lt;OrderLineReference&gt;
                          &lt;OrderLineId&gt;87338&lt;/OrderLineId&gt;
                          &lt;CalculatedRebate&gt;25.00&lt;/CalculatedRebate&gt;
                        &lt;/OrderLineReference&gt;
                      &lt;/OrderLineReferences&gt;
                    &lt;/Coupon&gt;
                  &lt;/Coupons&gt;
                  &lt;OrderLines count="2"&gt;
                    &lt;OrderLine num="1"&gt;
                      &lt;OrderLineId&gt;4448&lt;/OrderLineId&gt;
                      &lt;ExternProductId&gt;500166&lt;/ExternProductId&gt;
                      &lt;ProductName&gt;Rugby-Shirt Farbe grau, Größe M&lt;/ProductName&gt;
                      &lt;ItemNumber&gt;1497349-M&lt;/ItemNumber&gt;
                      &lt;EAN&gt;7391531298695&lt;/EAN&gt;
                      &lt;QuantityOrdered&gt;1&lt;/QuantityOrdered&gt;
