<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <!-- attribute groups -->
    <xs:attributeGroup name="defaultAttributeGroup">
        <xs:attribute name="ignoreOnUpdate" type="xs:integer" default="0"/>
    </xs:attributeGroup>
    <!-- own types -->
    <xs:complexType name="ItemString">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attributeGroup ref="defaultAttributeGroup"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="ItemInteger">
        <xs:simpleContent>
            <xs:extension base="xs:integer">
                <xs:attributeGroup ref="defaultAttributeGroup"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="ItemDecimal">
        <xs:simpleContent>
            <xs:extension base="xs:decimal">
                <xs:attributeGroup ref="defaultAttributeGroup"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="ItemDateTime">
        <xs:simpleContent>
            <xs:extension base="DateTime">
                <xs:attributeGroup ref="defaultAttributeGroup"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="ItemIntegerOrEmpty">
        <xs:simpleContent>
            <xs:extension base="integerOrEmpty">
                <xs:attributeGroup ref="defaultAttributeGroup"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="ItemDecimalOrEmpty">
        <xs:simpleContent>
            <xs:extension base="decimalOrEmpty">
                <xs:attributeGroup ref="defaultAttributeGroup"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:simpleType name="integerOrEmpty">
        <xs:union memberTypes="xs:integer emptyString"/>
    </xs:simpleType>
    <xs:simpleType name="decimalOrEmpty">
        <xs:union memberTypes="xs:decimal emptyString"/>
    </xs:simpleType>
    <xs:simpleType name="emptyString">
        <xs:restriction base="xs:string">
            <xs:enumeration value=""/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DateTime">
        <xs:restriction base="xs:token">
            <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2})?"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:element name="UID" type="xs:integer"/>
    <xs:element name="PrimeCost">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="ItemDecimalOrEmpty">
                    <xs:attribute name="cur" use="required" type="xs:string"/>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>
</xs:schema>
